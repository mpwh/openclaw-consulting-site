---
---
<section id="book" class="section-pad border-t border-white/5">
  <div class="container-sm text-center">
    <p class="text-accent text-sm font-medium tracking-widest uppercase mb-6">Get Started</p>
    <h2 class="text-4xl md:text-6xl font-bold tracking-tight mb-6">
      Ready to put AI<br />to work?
    </h2>
    <p class="text-neutral-400 text-lg leading-relaxed mb-8 max-w-xl mx-auto">
      Start with a free 15-minute call. I'll tell you honestly whether OpenClaw is the right
      fit for your business — and what we can build together.
    </p>

    <!-- Scarcity notice -->
    <div class="inline-flex items-center gap-2 bg-accent/10 border border-accent/20 text-accent text-sm font-medium px-4 py-2 rounded-full mb-8">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
      </span>
      Limited to 2 discovery calls per day — book ahead to secure your slot
    </div>

    <div class="block">
      <a
        href="https://app.cal.com/panduhartanto/oc-discovery"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 bg-accent hover:bg-accent-dim text-white font-semibold px-10 py-5 rounded-xl text-lg transition-colors"
      >
        Book Your Free Discovery Call →
      </a>
      <p class="mt-4 text-neutral-600 text-sm">Free · 15 minutes · Limited slots daily</p>
    </div>
  </div>

  <!-- Pricing section -->
  <div class="container-md mt-20">
    <div class="border-t border-white/5 pt-16">
      <p class="text-center text-neutral-500 text-sm font-medium tracking-widest uppercase mb-12">Investment</p>
      <div class="grid md:grid-cols-3 gap-6">

        <!-- Tier 1 -->
        <div class="rounded-2xl border border-white/10 bg-surface2 p-8 flex flex-col">
          <div class="mb-6">
            <p class="text-neutral-500 text-sm mb-2">Quick Start</p>
            <div class="flex items-baseline gap-1">
              <span class="text-4xl font-bold">$97</span>
              <span class="text-neutral-500 text-sm">/ session</span>
            </div>
            <p class="text-neutral-500 text-xs mt-1">Intro pricing · Limited availability</p>
          </div>
          <ul class="space-y-3 text-sm text-neutral-400 flex-1 mb-8">
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> 60-min guided setup session</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> OpenClaw installed + one channel connected</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Your first automation live (morning briefing)</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Session recording</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> 7-day WhatsApp follow-up</li>
          </ul>
          <a href="https://app.cal.com/panduhartanto/oc-discovery" target="_blank" rel="noopener"
            class="block text-center border border-white/10 hover:border-white/20 text-white text-sm font-medium py-3 rounded-lg transition-colors">
            Start with a free call →
          </a>
        </div>

        <!-- Tier 2 — Featured -->
        <div class="rounded-2xl border border-accent/30 bg-accent/5 p-8 flex flex-col relative">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2">
            <span class="bg-accent text-white text-xs font-semibold px-3 py-1 rounded-full">Most Popular</span>
          </div>
          <div class="mb-6">
            <p class="text-neutral-400 text-sm mb-2">Full Implementation</p>
            <div class="flex items-baseline gap-1">
              <span class="text-4xl font-bold">$197</span>
              <span class="text-neutral-500 text-sm">/ session</span>
            </div>
            <p class="text-neutral-500 text-xs mt-1">Intro pricing · Raises after 10 clients</p>
          </div>
          <ul class="space-y-3 text-sm text-neutral-300 flex-1 mb-8">
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> 90-min hands-on implementation</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Full install, config + agent persona</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> 2 custom automations live</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Model selection + cost optimization</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Written 30-day roadmap</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Session recording + setup guide</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> 14-day WhatsApp follow-up</li>
          </ul>
          <a href="https://app.cal.com/panduhartanto/oc-discovery" target="_blank" rel="noopener"
            class="block text-center bg-accent hover:bg-accent-dim text-white text-sm font-semibold py-3 rounded-lg transition-colors">
            Book discovery call →
          </a>
        </div>

        <!-- Tier 3 -->
        <div class="rounded-2xl border border-white/10 bg-surface2 p-8 flex flex-col">
          <div class="mb-6">
            <p class="text-neutral-500 text-sm mb-2">Monthly Advisory</p>
            <div class="flex items-baseline gap-1">
              <span class="text-4xl font-bold">$497</span>
              <span class="text-neutral-500 text-sm">/ month</span>
            </div>
            <p class="text-neutral-500 text-xs mt-1">Ongoing · Limited to 5 clients</p>
          </div>
          <ul class="space-y-3 text-sm text-neutral-400 flex-1 mb-8">
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Everything in Full Implementation</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> New automations built monthly</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> OpenClaw updates + optimization</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Priority WhatsApp support</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Monthly 30-min review call</li>
          </ul>
          <a href="https://app.cal.com/panduhartanto/oc-discovery" target="_blank" rel="noopener"
            class="block text-center border border-white/10 hover:border-white/20 text-white text-sm font-medium py-3 rounded-lg transition-colors">
            Apply via discovery call →
          </a>
        </div>

      </div>

      <!-- Payment note -->
      <p class="text-center text-neutral-600 text-sm mt-8">
        Payment via bank transfer (IDR/USD) or Wise · Invoice sent after discovery call · Clarity Guarantee on all sessions
      </p>
    </div>
  </div>
</section>
