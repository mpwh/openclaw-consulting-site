---
const services = [
  {
    num: '01',
    title: 'Architecture',
    desc: 'Which model, which config, which skills, which integrations. There are hundreds of decisions that determine whether your assistant actually helps or just runs in the background doing nothing. I make those decisions for you.',
  },
  {
    num: '02',
    title: 'Integration',
    desc: 'Your email, calendar, CRM, Notion, messaging apps, databases. I map your tools and connect what matters, so your assistant has real context to work with.',
  },
  {
    num: '03',
    title: 'Optimization',
    desc: 'The gap between a working setup and a useful one is prompt engineering, skill configuration, and knowing when to use which model. I handle that tuning.',
  },
  {
    num: '04',
    title: 'Security',
    desc: 'Your assistant only gets access to what you say it can touch. I help you find where to draw that line, then lock it down properly from the start.',
  },
];
---

<section class="section-pad border-t border-white/5">
  <div class="container-md">
    <p class="text-accent text-sm font-medium tracking-widest uppercase mb-4">How I Help</p>
    <h2 class="text-4xl md:text-5xl font-bold tracking-tight mb-16 max-w-2xl">
      What actually goes into a good setup.
    </h2>

    <div class="grid md:grid-cols-2 gap-px bg-white/5 rounded-2xl overflow-hidden">
      {services.map((s) => (
        <div class="bg-[#0a0a0a] p-8 hover:bg-surface2 transition-colors">
          <span class="text-accent text-sm font-mono font-medium mb-4 block">{s.num}</span>
          <h3 class="text-xl font-semibold mb-3">{s.title}</h3>
          <p class="text-neutral-400 leading-relaxed text-sm">{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
